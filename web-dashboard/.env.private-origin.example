ENVIRONMENT=production
DEBUG=false
AIOS_ENV_FILE=.env.production
AIOS_ORIGIN_PORT=8080

# Public application hostname(s), without scheme or path.
AIOS_ALLOWED_HOSTS=app.example.com,api.example.com,localhost,127.0.0.1

# Exact frontend origins only. Pydantic accepts JSON lists reliably.
CORS_ORIGINS=["https://app.example.com"]

# Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-at-least-32-random-characters

# Required only when using: docker compose --profile tunnel ...
# Store the real token in .env.production, never commit it.
CLOUDFLARE_TUNNEL_TOKEN=replace-on-server

POSTGRES_DB=aionex
POSTGRES_USER=aionex
POSTGRES_PASSWORD=replace-on-server
REDIS_URL=redis://redis:6379/0

# Keep provider credentials and Firebase admin JSON server-side only.
