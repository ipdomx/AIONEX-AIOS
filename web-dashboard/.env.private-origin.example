ENVIRONMENT=production
DEBUG=false
AIOS_ENV_FILE=.env.production
AIOS_ORIGIN_PORT=8080
AIOS_CONTROL_PORT=8081
AIOS_PORTAL_PORT=8082

# Keep the real value only in the server environment and Cloudflare Access.
AIOS_CONTROL_HOST=replace-with-private-control-hostname

# Public API, private control, and internal health-check hostnames.
AIOS_ALLOWED_HOSTS=api.vip-e.net,replace-with-private-control-hostname,backend,localhost,127.0.0.1

# The VIP site is the only public user registration and sign-in surface.
AIOS_USER_PORTAL_URL=https://ai.vip-e.net
AIOS_PUBLIC_PORTAL_ORIGINS=["https://ai.vip-e.net"]
CORS_ORIGINS=["https://ai.vip-e.net"]

# Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-at-least-32-random-characters

# Required only when using: docker compose --profile tunnel ...
# Store the real token in .env.production, never commit it.
CLOUDFLARE_TUNNEL_TOKEN=replace-on-server

POSTGRES_DB=aionex
POSTGRES_USER=aionex
POSTGRES_PASSWORD=replace-on-server
REDIS_URL=redis://redis:6379/0

# Keep provider credentials and Firebase admin JSON server-side only.
