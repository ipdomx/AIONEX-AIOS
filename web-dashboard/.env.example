# AIONEX AIOS — Environment Configuration
# Copy this file to .env and replace every placeholder before production use.

# Application
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4
SECRET_KEY=replace-with-a-secure-random-string-of-at-least-32-characters

# PostgreSQL
# DATABASE_URL may be left empty when using the bundled Docker Compose stack.
# The backend will construct an encoded asyncpg URL from the POSTGRES_* values.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
POSTGRES_DB=aionex
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=12

# CORS
CORS_ORIGINS=["http://localhost:3000","https://aionex.io"]

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Storage
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
