# AIONEX AIOS — Environment Configuration
# Copy this file to .env and replace every placeholder before production use.

# Application
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4
SECRET_KEY=replace-with-a-secure-random-string-of-at-least-32-characters
AIOS_IDENTITY_HASH_SECRET=

# PostgreSQL
# DATABASE_URL may be left empty when using the bundled Docker Compose stack.
# The backend will construct an encoded asyncpg URL from the POSTGRES_* values.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
POSTGRES_DB=aionex
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Durable PostgreSQL backup worker
BACKUP_DIR=/var/lib/aionex/backups
BACKUP_TIMEOUT_SECONDS=900
BACKUP_VALIDATION_TIMEOUT_SECONDS=900
BACKUP_CLEANUP_TIMEOUT_SECONDS=120
BACKUP_JOB_LEASE_SECONDS=3600
BACKUP_WORKER_POLL_SECONDS=5
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_INTERVAL_HOURS=24
BACKUP_WORKER_HEARTBEAT_SECONDS=10
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_FREE_BYTES=1073741824

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=12
AIOS_BOOTSTRAP_OWNER_EMAIL=owner@aionex.local
AIOS_BOOTSTRAP_OWNER_PASSWORD=
AIOS_BOOTSTRAP_RESET_OWNER_PASSWORD=false

# CORS
CORS_ORIGINS=["http://localhost:3000","https://aionex.io"]

# Firebase phone OTP and social OAuth/OIDC
# Browser values identify the Firebase web app and are not service-account secrets.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Docker Compose overrides this host-side value with /run/secrets/aionex/firebase-admin.json.
FIREBASE_ADMIN_CREDENTIALS_JSON=/run/secrets/aionex/firebase-admin.json
FIREBASE_PHONE_TOKEN_MAX_AGE_SECONDS=900
FIREBASE_SOCIAL_PROVIDERS=["google","apple","facebook","x","instagram"]
FIREBASE_SOCIAL_PROVIDER_IDS={"google":"google.com","apple":"apple.com","facebook":"facebook.com","x":"twitter.com","instagram":"oidc.instagram"}
FIREBASE_SOCIAL_TOKEN_MAX_AGE_SECONDS=300
FIREBASE_SOCIAL_REGISTRATION_TTL_SECONDS=900

# Device-bound WebAuthn passkeys
PASSKEY_ENABLED=true
PASSKEY_RP_ID=vip-e.net
PASSKEY_RP_NAME=AIONEX AIOS
PASSKEY_ALLOWED_ORIGINS=["https://vip-e.net","https://www.vip-e.net"]
PASSKEY_CHALLENGE_TTL_SECONDS=300

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Communications and durable notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
COMMUNICATION_WORKER_POLL_SECONDS=2
COMMUNICATION_DELIVERY_LEASE_SECONDS=120
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_SECONDS=30
COMMUNICATION_WORKER_HEALTH_FILE=/tmp/aionex-communication-worker-health.json
# External providers remain disabled until all required fields are supplied.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set an explicit supported Graph API base during provider activation.
WHATSAPP_API_BASE=

# Storage
STORAGE_TYPE=local
# Phase 34D private 3D pipeline. Production uses STORAGE_TYPE=s3 and the
# AWS_* values below; RunPod credentials remain in secrets/RUNPOD_GPU.env.
THREE_D_RUNPOD_SECRET_FILE=/run/secrets/aionex/runpod-gpu.env
THREE_D_WORKER_POLL_SECONDS=2
THREE_D_JOB_LEASE_SECONDS=180
THREE_D_WORKER_HEALTH_FILE=/tmp/aionex-three-d-worker-health.json
THREE_D_GPU_COST_PER_SECOND_USD=0.0002
THREE_D_MAX_OUTPUT_BYTES=104857600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 29G operations observer
OPERATIONS_OBSERVER_INTERVAL_SECONDS=30
ACCOUNT_LIFECYCLE_ALERT_INTERVAL_SECONDS=900
OPERATIONS_OBSERVER_HEALTH_FILE=/tmp/aionex-operations-observer-health.json
# Phase 29H provider-neutral Production Studio and mobile releases
STUDIO_ASSET_ROOT=/var/lib/aionex/studio-assets
STUDIO_WORKER_POLL_SECONDS=2
STUDIO_JOB_LEASE_SECONDS=300
STUDIO_WORKER_HEARTBEAT_SECONDS=10
STUDIO_MAX_ARTIFACT_BYTES=52428800
STUDIO_WORKER_HEALTH_FILE=/tmp/aionex-studio-worker-health.json
MOBILE_RELEASE_ROOT=/var/lib/aionex/mobile-releases
# Native mobile store subscriptions (server verification; secrets stay server-side)
APP_STORE_BUNDLE_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=net.vipe.aionex
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Native mobile store billing server lifecycle
APP_STORE_BUNDLE_ID=net.vipe.aionex
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_APPLE_ID=
APP_STORE_ENVIRONMENT=sandbox
APP_STORE_ROOT_CERTIFICATES_DIR=/run/secrets/apple-root-certificates
GOOGLE_PLAY_PACKAGE_NAME=net.vipe.aionex
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
