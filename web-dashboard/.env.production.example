POSTGRES_USER=aionex
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=aionex
# Compose must load this file into backend and worker containers, not only use
# it for variable interpolation.
AIOS_ENV_FILE=.env.production
# Optional legacy override. Keep the same user/database; its password is authoritative.
DATABASE_URL=
BACKUP_TIMEOUT_SECONDS=900
BACKUP_VALIDATION_TIMEOUT_SECONDS=900
BACKUP_CLEANUP_TIMEOUT_SECONDS=120
BACKUP_JOB_LEASE_SECONDS=3600
BACKUP_WORKER_POLL_SECONDS=5
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_INTERVAL_HOURS=24
BACKUP_WORKER_HEARTBEAT_SECONDS=10
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
# Optional internal OWASP ZAP service. Keep the API key secret and enable the
# Compose "security-tools" profile only when the isolated ZAP daemon is required.
SECURITY_ZAP_URL=
SECURITY_ZAP_API_KEY=
BACKUP_MIN_FREE_BYTES=1073741824
SECRET_KEY=replace-with-at-least-64-random-characters
# Optional separate HMAC key for protected identity fingerprints; SECRET_KEY is the fallback.
AIOS_IDENTITY_HASH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://vip-e.net","https://ai.vip-e.net"]
# Browser origins that must never receive a Super Owner session.
AIOS_PUBLIC_PORTAL_ORIGINS=["https://ai.vip-e.net"]
AIOS_PUBLIC_ORIGIN=https://vip-e.net
AIOS_API_ORIGIN=https://api.vip-e.net
AIOS_USER_PORTAL_URL=https://ai.vip-e.net
# Keep the real control hostname only in the server environment and Cloudflare.
AIOS_CONTROL_HOST=replace-with-private-control-hostname
AIOS_CONTROL_PORT=8081
# Localhost-only origin for the public user portal; publish through ai.vip-e.net.
AIOS_PORTAL_PORT=8082
# Public API, private control, and internal health-check hostnames.
AIOS_ALLOWED_HOSTS=api.vip-e.net,replace-with-private-control-hostname,localhost,127.0.0.1,backend
PASSWORD_MIN_LENGTH=12
AIOS_BOOTSTRAP_OWNER_EMAIL=owner@aionex.local
AIOS_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-temporary-owner-password
AIOS_BOOTSTRAP_RESET_OWNER_PASSWORD=false
MFA_ENABLED=true
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Compose interpolation placeholder used only for configuration validation.
# Replace it with the real token only when enabling the optional tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Firebase Web configuration. These values are browser configuration, not the Admin private key.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Production Compose overrides this to the protected read-only container mount.
FIREBASE_ADMIN_CREDENTIALS_JSON=/run/secrets/aionex/firebase-admin.json
FIREBASE_PHONE_TOKEN_MAX_AGE_SECONDS=900
FIREBASE_SOCIAL_PROVIDERS=["google","apple","facebook","x","instagram"]
FIREBASE_SOCIAL_PROVIDER_IDS={"google":"google.com","apple":"apple.com","facebook":"facebook.com","x":"twitter.com","instagram":"oidc.instagram"}
FIREBASE_SOCIAL_TOKEN_MAX_AGE_SECONDS=300
FIREBASE_SOCIAL_REGISTRATION_TTL_SECONDS=900

PASSKEY_ENABLED=true
PASSKEY_RP_ID=your-domain.example
PASSKEY_RP_NAME=AIONEX AIOS
PASSKEY_ALLOWED_ORIGINS=["https://your-domain.example"]
PASSKEY_CHALLENGE_TTL_SECONDS=300

# AI agent-runtime provider credentials. Empty values remain unconfigured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_BEDROCK_REGION=
AWS_SESSION_TOKEN=

# Communications and durable notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
COMMUNICATION_WORKER_POLL_SECONDS=2
COMMUNICATION_DELIVERY_LEASE_SECONDS=120
COMMUNICATION_MAX_ATTEMPTS=5
COMMUNICATION_RETRY_BASE_SECONDS=30
COMMUNICATION_WORKER_HEALTH_FILE=/tmp/aionex-communication-worker-health.json
# External providers remain disabled until all required fields are supplied.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set an explicit supported Graph API base during provider activation.
WHATSAPP_API_BASE=

# Controlled single-server AI project planning worker.
PROJECT_EXECUTION_ENABLED=true
PROJECT_EXECUTION_BUDGET_CAP_USD=0.05
PROJECT_EXECUTION_WEB_SEARCH_COST_USD=0.01
PROJECT_EXECUTION_RESEARCH_MODEL=gpt-5.4-nano
PROJECT_EXECUTION_WORKER_POLL_SECONDS=2
PROJECT_EXECUTION_JOB_LEASE_SECONDS=900
PROJECT_EXECUTION_HEARTBEAT_SECONDS=10
# Autonomous full 3D web-project assets. TRIPO_API_KEY is server-side only.
PROJECT_3D_AUTOGEN_ENABLED=true
PROJECT_3D_AUTOGEN_ASSET_COUNT=4
PROJECT_3D_AUTOGEN_TIMEOUT_SECONDS=300
# Conservative wallet planning floor; actual usage comes from Tripo V3 credits_consumed.
PROJECT_3D_TRIPO_CREDITS_PER_ASSET=40
TRIPO_API_KEY=
# Operator-managed paths used by the optional ai-execution Compose profile.
AIOS_PROJECT_EXECUTION_SECRET_HOST_FILE=/root/.config/aionex/phase22c-openai.env
AIOS_PHASE22B_REFERENCE_HOST_DIR=/var/tmp/aionex-phase22b/sandbox-output/local-qwen3-8b

# Phase 34D private 3D generation. Production requires STORAGE_TYPE=s3 and
# private S3 credentials supplied by the operator. RunPod credentials stay in
# web-dashboard/secrets/RUNPOD_GPU.env (0600) and are mounted read-only.
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
THREE_D_RUNPOD_SECRET_FILE=/run/secrets/aionex/runpod-gpu.env
THREE_D_WORKER_POLL_SECONDS=2
THREE_D_JOB_LEASE_SECONDS=180
THREE_D_WORKER_HEALTH_FILE=/tmp/aionex-three-d-worker-health.json
THREE_D_GPU_COST_PER_SECOND_USD=0.0002
THREE_D_MAX_OUTPUT_BYTES=104857600


# Optional owner-allowlisted Telegram polling worker. The token stays in a
# root-owned external file and is never committed or stored in this env file.
AIOS_TELEGRAM_BOT_TOKEN_HOST_FILE=/root/.config/aionex/telegram/bot-token
AIOS_TELEGRAM_ALLOWED_USERS=[]
AIOS_TELEGRAM_LONG_POLL_SECONDS=25
AIOS_TELEGRAM_HEALTH_FILE=/tmp/aionex-telegram-worker-health.json

# Owner-controlled VIP portal configuration and asset library.
PORTAL_ASSET_ROOT=/var/lib/aionex/portal-assets
PORTAL_PUBLIC_API_ORIGIN=https://api.vip-e.net
PORTAL_ASSET_MAX_BYTES=10485760
PORTAL_PUBLIC_CACHE_SECONDS=60

# Phase 29G operations observer
OPERATIONS_OBSERVER_INTERVAL_SECONDS=30
ACCOUNT_LIFECYCLE_ALERT_INTERVAL_SECONDS=900
OPERATIONS_OBSERVER_HEALTH_FILE=/tmp/aionex-operations-observer-health.json
# Phase 29H provider-neutral Production Studio and mobile releases
STUDIO_ASSET_ROOT=/var/lib/aionex/studio-assets
STUDIO_WORKER_POLL_SECONDS=2
STUDIO_JOB_LEASE_SECONDS=300
STUDIO_WORKER_HEARTBEAT_SECONDS=10
STUDIO_MAX_ARTIFACT_BYTES=52428800
STUDIO_WORKER_HEALTH_FILE=/tmp/aionex-studio-worker-health.json
MOBILE_RELEASE_ROOT=/var/lib/aionex/mobile-releases
