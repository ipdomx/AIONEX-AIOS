{
  "services": {
    "backend": {
      "environment": {
        "AIOS_META_OWNED_TOKEN_FILE": "/run/operator-secrets/meta-owned-token",
        "AIOS_META_SANDBOX_TOKEN_FILE": "/run/operator-secrets/meta-sandbox-token",
        "AIOS_META_SANDBOX_AD_ACCOUNT_ID": "${AIOS_META_SANDBOX_AD_ACCOUNT_ID:?AIOS_META_SANDBOX_AD_ACCOUNT_ID is required}"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${AIOS_META_OWNED_TOKEN_HOST_FILE:?AIOS_META_OWNED_TOKEN_HOST_FILE required}",
          "target": "/run/operator-secrets/meta-owned-token",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${AIOS_META_SANDBOX_TOKEN_HOST_FILE:?AIOS_META_SANDBOX_TOKEN_HOST_FILE required}",
          "target": "/run/operator-secrets/meta-sandbox-token",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    }
  }
}
