  "cutover_orchestration": {
    "production_cutover_allowed_by_this_contract": false,
    "prerequisites": [
      "exact protected PR head and exact post-merge main checks are successful",
      "fresh encrypted R2 recovery point is created and independently restored immediately before the window",
      "active and recovery keys are outside the unencrypted host root and held independently",
      "LUKS2 header backups are off-host and separate from recovery keys",
      "owner-visible out-of-band missing-vault alert works while both vaults and the host application are unavailable",
      "both external Docker volume objects match their exact mapper, filesystem, and mount-option contracts",
      "all eleven target subpaths exist with verified ownership and mode before Compose container creation",
      "maintenance admission is closed and every affected queue has a retained drain receipt",
      "no unaccounted host process or container has an open writable descriptor in any source root",
      "boot, Docker daemon restart, missing mapper, wrong key, and delayed unlock behaviors are rehearsed in an isolated environment"
    ],
    "ordered_steps": [
      "Close application admission without changing Cloudflare and retain an owner-visible maintenance receipt.",
      "Drain in-flight work to zero, then stop all eighteen runtime writer service definitions and verify every scaled instance is absent.",
      "Keep initializer services stopped; stop read-only consumers before changing their mounts.",
      "Create final source manifests, apply the final delta into the already-preseeded encrypted vaults, and require stable source-before, source-after, and candidate equality.",
      "Reverify external volume options and mapper identity, then render the base plus overlay and require all fifty-four protected mounts to use the expected vault subpath with unchanged access mode.",
      "Start only the affected services in dependency order with admission still closed; require health, queue, permission, noexec, build, backup-read, and restart checks.",
      "Measure workload-specific p95 against the retained baseline and reject regression greater than fifteen percent.",
      "Open admission only after all acceptance gates pass; retain the legacy named volumes and evidence through the rollback window."
    ],
    "stop_scope_rule": "Resolve every live container for each service label at execution time; a source service definition may have multiple scaled containers.",
    "unlisted_writer_rule": "Any unlisted writable descriptor, mount, container, or host process blocks cutover.",
    "unrelated_service_rule": "Do not stop, recreate, or restart services outside the resolved affected set."
  },
  "rollback": {
    "legacy_sources_deleted_during_window": false,
    "pre_admission_failure": "Keep writers closed, remove the overlay, recreate only affected consumers against the retained legacy volumes, verify manifests and health, then decide whether to reopen admission.",
    "post_admission_failure": "Close admission again, drain and stop writers, temporarily make the retained legacy roots writable only for a reverse stable-delta copy from the encrypted vaults, require exact manifests, then recreate affected consumers without the overlay.",
