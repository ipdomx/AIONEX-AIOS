{
  "name": "aionex-aios-vip-frontend",
  "version": "1.6.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --require ./scripts/process-memory-shim.cjs ./node_modules/next/dist/bin/next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "node --require ./scripts/process-memory-shim.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "check:integrity": "node scripts/check-integrity.mjs",
    "smoke": "node --require ./scripts/process-memory-shim.cjs scripts/smoke-test.mjs",
    "smoke:static": "node scripts/static-smoke-test.mjs",
    "verify": "npm run check:integrity && npm run type-check && npm run lint && npm run build && npm run smoke",
    "verify:static": "npm run check:integrity && npm run type-check && npm run lint && npm run build:static && npm run smoke:static"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "12.16.0",
    "lucide-react": "0.468.0",
    "next": "15.5.22",
    "next-intl": "4.13.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.180.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
