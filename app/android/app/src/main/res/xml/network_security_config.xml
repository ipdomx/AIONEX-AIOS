<?xml version="1.0" encoding="utf-8"?>
<!-- No plain HTTP anywhere, and only the system's CAs (never user-installed ones).
     Dart's HTTP client additionally pins the API to assets/security/api_roots.pem. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
