{
  "schema": 1,
  "semantics": {
    "reachability_only": true,
    "dependabot_closure": false,
    "preserved_open_alerts": [48, 50],
    "final_live_closure_gated_by": ["FR-06", "FR-21"],
    "notes": [
      "Absence from a linked binary is mitigation/reachability evidence only, not closure of a source dependency alert.",
      "Host Docker maintenance and shared dependency refresh remain coordinator/actual-owner work."
    ]
  },
  "tools": {
    "trivy": {
      "minimum_dependency_count": 10,
      "rules": [
        {
          "id": "trivy-legacy-docker-not-linked",
          "mode": "absent",
          "module": "github.com/docker/docker",
          "closure_effect": "none"
        },
        {
          "id": "trivy-containerd-floor-or-absent",
          "mode": "min_version_or_absent",
          "module": "github.com/containerd/containerd/v2",
          "minimum": "v2.3.6",
          "closure_effect": "none"
        },
        {
          "id": "trivy-otel-family-floor-or-absent",
          "mode": "prefix_min_version_or_absent",
          "prefix": "go.opentelemetry.io/otel",
          "minimum": "v1.45.0",
          "closure_effect": "none"
        }
      ]
    },
    "grype": {
      "minimum_dependency_count": 10,
      "rules": [
        {
          "id": "grype-legacy-docker-not-linked",
          "mode": "absent",
