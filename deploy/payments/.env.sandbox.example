# AIONEX AIOS Phase 29D payments sandbox configuration
# Never commit real credentials. Hosted checkout keeps card data outside AIOS.

PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_DEFAULT_CURRENCY=USD
PAYMENTS_SUCCESS_URL=https://ai.vip-e.net/en/billing?checkout=success
PAYMENTS_CANCEL_URL=https://ai.vip-e.net/en/billing?checkout=cancelled
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe hosted Checkout, subscriptions, refunds and verified webhooks.
# Apple Pay, Google Pay and Mada are exposed through eligible Stripe payment methods.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# PayPal subscriptions, refunds and verified webhooks.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Paddle subscriptions, tax-aware checkout, refunds and verified webhooks.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE=https://sandbox-api.paddle.com

# Local-provider verified callback intake.
# No hosted local checkout is advertised until a provider-specific adapter is enabled.
PAYMOB_WEBHOOK_SECRET=
FAWRY_WEBHOOK_SECRET=
STC_PAY_WEBHOOK_SECRET=

# Offline bank-transfer checkout.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
