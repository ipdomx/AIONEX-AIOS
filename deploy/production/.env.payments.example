# AIONEX AIOS Phase 29D payment runtime
# Copy only the required variables into the secret-managed production env.
# Never commit real credentials. Hosted checkout keeps card data outside AIOS.

# Shared payment policy
PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_DEFAULT_CURRENCY=USD
PAYMENTS_SUCCESS_URL=https://ai.vip-e.net/en/billing?checkout=success
PAYMENTS_CANCEL_URL=https://ai.vip-e.net/en/billing?checkout=cancelled
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe hosted Checkout, subscriptions, refunds, billing portal,
# Google Pay and eligible Stripe payment methods. Apple Pay is intentionally
# excluded here because AIOS keeps the requested direct Apple Pay gateway separate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
# P5.3: Stripe Checkout and customer-portal return to
# <PAYMENTS_PORTAL_BASE_URL>/<locale>/billing (see docs/project/STRIPE-GO-LIVE-RUNBOOK.md).
PAYMENTS_PORTAL_BASE_URL=https://ai.vip-e.net
# Stripe Tax: true lets Stripe compute tax from the billing address.
# When false, map each local exclusive tax code: VAT_AE=txr_...,VAT_SA=txr_...
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_RATES=
# Optional customer-portal configuration id (bpc_...); empty uses the default.
STRIPE_PORTAL_CONFIGURATION_ID=

# PayPal subscriptions and verified webhooks.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Paddle subscriptions, tax-aware checkout, refunds, and verified webhooks.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE=https://sandbox-api.paddle.com

# Local-provider verified callback intake.
# Checkout remains unavailable until a provider-specific hosted adapter is
# explicitly implemented and enabled; AIOS never collects card data directly.
PAYMOB_API_KEY=
PAYMOB_WEBHOOK_SECRET=
FAWRY_API_KEY=
FAWRY_WEBHOOK_SECRET=
STC_PAY_API_KEY=
STC_PAY_WEBHOOK_SECRET=

# Offline bank-transfer checkout. The values below are returned only to an
# authenticated organization billing manager after creating an invoice.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
# Native mobile store subscriptions (server verification; secrets stay server-side)
APP_STORE_BUNDLE_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=net.vipe.aionex
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Native mobile store billing server lifecycle
APP_STORE_BUNDLE_ID=net.vipe.aionex
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_APPLE_ID=
APP_STORE_ENVIRONMENT=sandbox
APP_STORE_ROOT_CERTIFICATES_DIR=/run/secrets/apple-root-certificates
GOOGLE_PLAY_PACKAGE_NAME=net.vipe.aionex
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
