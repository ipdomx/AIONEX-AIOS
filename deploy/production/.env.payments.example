# AIONEX AIOS Phase 29D payment runtime
# Copy only the required variables into the secret-managed production env.
# Never commit real credentials. Hosted checkout keeps card data outside AIOS.

# Shared payment policy
PAYMENTS_ENVIRONMENT=sandbox
PAYMENTS_DEFAULT_CURRENCY=USD
PAYMENTS_SUCCESS_URL=https://ai.vip-e.net/en/billing?checkout=success
PAYMENTS_CANCEL_URL=https://ai.vip-e.net/en/billing?checkout=cancelled
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe hosted Checkout, subscriptions, refunds, billing portal,
# Apple Pay, Google Pay, and eligible dynamic payment methods.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# PayPal subscriptions and verified webhooks.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Paddle subscriptions, tax-aware checkout, refunds, and verified webhooks.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_BASE=https://sandbox-api.paddle.com

# Local-provider verified callback intake.
# Checkout remains unavailable until a provider-specific hosted adapter is
# explicitly implemented and enabled; AIOS never collects card data directly.
PAYMOB_API_KEY=
PAYMOB_WEBHOOK_SECRET=
FAWRY_API_KEY=
FAWRY_WEBHOOK_SECRET=
STC_PAY_API_KEY=
STC_PAY_WEBHOOK_SECRET=

# Offline bank-transfer checkout. The values below are returned only to an
# authenticated organization billing manager after creating an invoice.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
# Native mobile store subscriptions (server verification; secrets stay server-side)
APP_STORE_BUNDLE_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=net.vipe.aionex
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
