# AIONEX AIOS Payments Production Environment
# Copy to a secret-managed runtime environment. Never commit real credentials.

PAYMENTS_ENV=production
PAYMENTS_DEFAULT_CURRENCY=USD
PAYMENTS_PUBLIC_ORIGIN=https://vip-e.net
PAYMENTS_API_ORIGIN=https://api.vip-e.net

# Stripe / Apple Pay / Google Pay
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_PAYMENT_METHODS=true
APPLE_PAY_ENABLED=false
GOOGLE_PAY_ENABLED=false

# PayPal
PAYPAL_ENABLED=false
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Paddle
PADDLE_ENABLED=false
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# Local providers
PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
FAWRY_ENABLED=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
STC_PAY_ENABLED=false
STC_PAY_MERCHANT_ID=
STC_PAY_SECRET=
MADA_ENABLED=false
MADA_MERCHANT_ID=
MADA_SECRET=

# Bank transfer
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_BANK_NAME=

# Security and operations
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENTS_REQUIRE_HTTPS=true
PAYMENTS_ALLOW_TEST_KEYS=false
PAYMENTS_AUDIT_LOG_ENABLED=true
PAYMENTS_IDEMPOTENCY_ENABLED=true
