# Public origins
PUBLIC_DOMAIN=ai.vip-e.net
API_DOMAIN=api.ai.vip-e.net
PUBLIC_ORIGIN=https://ai.vip-e.net
API_ORIGIN=https://api.ai.vip-e.net

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

# Database and cache
# Optional legacy override. Keep the same user/database; its password is authoritative.
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aios
POSTGRES_USER=aios
POSTGRES_PASSWORD=CHANGE_ME
BACKUP_TIMEOUT_SECONDS=900
BACKUP_VALIDATION_TIMEOUT_SECONDS=900
BACKUP_CLEANUP_TIMEOUT_SECONDS=120
BACKUP_JOB_LEASE_SECONDS=3600
BACKUP_WORKER_POLL_SECONDS=2
BACKUP_WORKER_HEARTBEAT_SECONDS=10
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_FREE_BYTES=1073741824
REDIS_URL=redis://redis:6379/0
AIOS_BOOTSTRAP_OWNER_EMAIL=owner@example.com
AIOS_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_WITH_A_STRONG_OWNER_PASSWORD

# Security
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
AIOS_IDENTITY_HASH_SECRET=
CORS_ORIGINS=["https://ai.vip-e.net"]

# Compose interpolation placeholder used only for configuration validation.
# Replace it with the real token only when enabling the optional tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Firebase phone OTP
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_ADMIN_CREDENTIALS_JSON=/run/secrets/aionex/firebase-admin.json
FIREBASE_PHONE_TOKEN_MAX_AGE_SECONDS=900

# External providers are injected at deployment time
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
