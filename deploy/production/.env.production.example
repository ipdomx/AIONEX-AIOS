# Public origins
PUBLIC_ORIGIN=https://ai.vip-e.net
API_ORIGIN=https://api.ai.vip-e.net
NEXT_PUBLIC_API_ORIGIN=https://api.ai.vip-e.net

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

# Database and cache
DATABASE_URL=postgresql+psycopg://aios:CHANGE_ME@postgres:5432/aios
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
ALLOWED_ORIGINS=https://ai.vip-e.net

# External providers are injected at deployment time
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
