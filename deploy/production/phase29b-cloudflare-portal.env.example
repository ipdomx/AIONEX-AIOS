# Copy to the fixed root-only path below; never commit the populated file:
# /root/.config/aionex/cloudflare/phase29b-portal.env
# Directory mode: 0700. File owner: root:root. File mode: 0600.
# Required token permissions: Zone Read, DNS Write, and Cloudflare Tunnel Write
# for the AIONEX account and vip-e.net zone only.
CLOUDFLARE_API_TOKEN=replace-with-scoped-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_ZONE_ID=replace-with-32-character-zone-id
